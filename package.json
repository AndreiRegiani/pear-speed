{
  "name": "pear-speed",
  "version": "0.2.0",
  "description": "P2P speed test",
  "bin": {
    "pear-speed": "bin.mjs"
  },
  "upgrade": "pear://<YOUR_KEY_HERE>",
  "files": [
    "index.js",
    "bin.mjs",
    "app.js",
    "cmd",
    "workers",
    "scripts",
    "ops"
  ],
  "main": "index.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "prettier --check . && lunte",
    "test": "bare test/index.js",
    "start": "bare bin.mjs --no-updates",
    "make": "bare scripts/make.js",
    "make:darwin-arm64": "bare-build --name pear-speed --standalone --host darwin-arm64 --out ./out/darwin-arm64 bin.mjs",
    "make:darwin-x64": "bare-build --name pear-speed --standalone --host darwin-x64 --out ./out/darwin-x64 bin.mjs",
    "make:linux-arm64": "bare-build --name pear-speed --standalone --host linux-arm64 --out ./out/linux-arm64 bin.mjs",
    "make:linux-x64": "bare-build --name pear-speed --standalone --host linux-x64 --out ./out/linux-x64 bin.mjs",
    "make:win32-arm64": "bare-build --name pear-speed --standalone --host win32-arm64 --out ./out/win32-arm64 bin.mjs",
    "make:win32-x64": "bare-build --name pear-speed --standalone --host win32-x64 --out ./out/win32-x64 bin.mjs"
  },
  "dependencies": {
    "b4a": "^1.8.1",
    "bare-crypto": "^1.15.3",
    "bare-env": "^3.0.1",
    "bare-events": "^2.9.1",
    "bare-os": "^3.9.3",
    "bare-path": "^3.1.1",
    "bare-process": "^4.5.0",
    "bare-storage": "^1.1.0",
    "bare-tty": "^5.1.0",
    "bare-tui": "^0.0.3",
    "corestore": "^7.12.2",
    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hyperswarm": "^4.17.0",
    "ip3country": "5.0.0",
    "paparam": "^1.13.0",
    "pear-gracedown": "^1.0.5",
    "pear-runtime": "^1.3.1",
    "ready-resource": "^1.2.0",
    "which-runtime": "^1.4.0"
  },
  "devDependencies": {
    "bare-build": "^1.0.4",
    "bare-runtime": "^1.31.0",
    "bare-subprocess": "^6.1.0",
    "brittle": "^4.1.0",
    "hyperdht": "^6.21.0",
    "lunte": "^1.8.4",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "engines": {
    "bare": ">=1.30.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AndreiRegiani/pear-speed.git"
  },
  "author": "Andrei Regiani",
  "license": "Apache-2.0"
}
